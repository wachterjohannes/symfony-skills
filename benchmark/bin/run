#!/usr/bin/env bash
# Run one benchmark task in one variant and capture the diff the agent produced.
# Mechanical only: it never decides whether the result is good.
#
#   bin/run 01-lock with-skills
#   bin/run 01-lock without-skills
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo="$(cd "$here/.." && pwd)"

task="${1:?usage: bin/run <task> <with-skills|without-skills>}"
variant="${2:?usage: bin/run <task> <with-skills|without-skills>}"

task_dir="$here/tasks/$task"
[ -d "$task_dir" ] || { echo "error: no task '$task' in $here/tasks" >&2; exit 1; }

case "$variant" in
    with-skills|without-skills) ;;
    *) echo "error: variant must be 'with-skills' or 'without-skills'" >&2; exit 1 ;;
esac

# Which agent is being benchmarked. It decides where the skills are installed and how
# isolation is arranged — the two things that differ per agent.
AGENT_KIND="${AGENT_KIND:-claude}"

# The model is pinned rather than left to whatever the host defaults to. Opus 5 is the
# default so a run without an override continues the existing series rather than quietly
# starting a new one.
case "$AGENT_KIND" in
    claude)
        AGENT_CMD="${AGENT_CMD:-claude -p --dangerously-skip-permissions --strict-mcp-config --model claude-opus-5}"
        ;;
    opencode)
        AGENT_CMD="${AGENT_CMD:?set AGENT_CMD for opencode, e.g. opencode run --model ollama/kimi-k2.7-code}"
        ;;
    *)
        echo "error: AGENT_KIND must be 'claude' or 'opencode'" >&2
        exit 1
        ;;
esac

# A pristine CLAUDE_CONFIG_DIR keeps the operator's own CLAUDE.md, globally
# installed skills, plugins and MCP servers out of the run — otherwise both
# variants silently inherit them and the baseline is not a baseline.
#
# The login is bound to the config directory, so an isolated run needs its own
# credential. Create one once with `claude setup-token` and export it as
# CLAUDE_CODE_OAUTH_TOKEN, or use ANTHROPIC_API_KEY.
agent_config=""
if [ "$AGENT_KIND" = "opencode" ]; then
    # opencode reads its configuration from XDG_CONFIG_HOME; an empty one removes the
    # operator's global agents, MCP servers and instructions the same way a pristine
    # CLAUDE_CONFIG_DIR does for Claude Code.
    isolation="clean"
    agent_config="$(mktemp -d)"
elif [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    isolation="clean"
    agent_config="$(mktemp -d)"
elif [ "${BENCHMARK_ALLOW_INHERITED:-0}" = "1" ]; then
    isolation="inherited"
else
    cat >&2 <<'MSG'
error: refusing to run without an isolated agent configuration.

Without it the agent inherits ~/.claude/CLAUDE.md, the globally installed
skills and any configured MCP servers — in both variants — so the numbers
say more about this machine than about the skills.

  claude setup-token
  export CLAUDE_CODE_OAUTH_TOKEN=<the token it prints>

Set BENCHMARK_ALLOW_INHERITED=1 to run anyway. The mode is recorded in
environment.txt either way, so a result can never claim to be clean when it
was not.
MSG
    exit 1
fi

# The project is built OUTSIDE this repository on purpose: an agent working
# inside it would have the skills sitting in an ancestor directory and could
# read them in either variant, which is exactly what the two variants are
# supposed to differ by.
workdir="${BENCHMARK_WORKDIR:-${TMPDIR:-/tmp}/symfony-skills-benchmark}"

# Every configuration needs its own directory, or a second one silently overwrites the
# first. Derived from the model when one is named, so the common case needs no extra
# thought.
label="${BENCHMARK_LABEL:-$(printf '%s' "$AGENT_CMD" | sed -n 's/.*--model[ =]\([^ ]*\).*/\1/p' | tr '/:' '--')}"
label="${label:-default}"

out="$here/results/$task/$label/$variant"
app="$workdir/$task/$label/$variant/app"

# Evidence lives one level up, because $out is cleared on every invocation and a
# repetition would otherwise erase the record of the one before it.
evidence="$here/results/$task/evidence"

rm -rf "$out" "$app"
mkdir -p "$out" "$evidence" "$(dirname "$app")"

symfony new "$app" --webapp --no-git >"$out/setup.log" 2>&1

cd "$app"
git init -q
git add -A
git -c user.email=benchmark@example.com -c user.name=benchmark commit -qm baseline

if [ "$variant" = "with-skills" ]; then
    case "$AGENT_KIND" in
        claude)
            mkdir -p .claude/skills
            cp -R "$repo/skills/." .claude/skills/
            echo '.claude/' > .git/info/exclude
            ;;
        opencode)
            # opencode has no skill system, so this follows docs/opencode.md exactly:
            # the folders plus the index from AGENTS.md, paths adjusted. Running the
            # benchmark this way also exercises the install path we document.
            mkdir -p .agents/skills
            cp -R "$repo/skills/." .agents/skills/
            sed 's|skills/|.agents/skills/|g' "$repo/AGENTS.md" > AGENTS.md
            printf '.agents/\nAGENTS.md\n' > .git/info/exclude
            ;;
    esac
fi

# Session plumbing from a surrounding Claude Code session would otherwise make
# this run a child of it. The -u flags must precede any NAME=value assignment:
# GNU env accepts either order, but uutils' env (the Rust reimplementation,
# increasingly the /usr/bin/env a distro ships) stops parsing options at the
# first assignment and then treats the next `-u` as the command to execute.
env -u CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD \
    -u CLAUDE_CODE_BRIDGE_SESSION_ID \
    -u CLAUDE_CODE_CHILD_SESSION \
    -u CLAUDE_CODE_ENTRYPOINT \
    -u CLAUDE_CODE_MESSAGING_SOCKET \
    -u CLAUDE_CODE_MESSAGING_TOKEN \
    -u CLAUDE_CODE_SESSION_ID \
    ${agent_config:+XDG_CONFIG_HOME="$agent_config"} \
    ${agent_config:+CLAUDE_CONFIG_DIR="$agent_config"} \
    $AGENT_CMD < "$task_dir/TASK.md" > "$out/agent.log" 2>&1 || true

# An isolation step that fails does so silently — the run produces empty diffs, not an
# error — so the absence of output is the signal worth catching.
if [ ! -s "$out/agent.log" ]; then
    echo "warning: $task/$label/$variant produced no agent output at all — check isolation and the agent command" >&2
fi

git add -A

# composer.lock is nearly all of the raw diff and says nothing a reviewer
# needs. symfony.lock stays: it is small, and its recipe entries are the
# evidence that a component was installed properly rather than wired by hand.
git diff --cached -- . ':(exclude)composer.lock' > "$out/diff.patch"
git diff --cached -- composer.json > "$out/packages.patch"

# The Symfony skeleton ships a compose.yaml and agents tend to start it.
if [ -f compose.yaml ] || [ -f docker-compose.yml ]; then
    docker compose down -v >/dev/null 2>&1 || true
fi

{
    echo "isolation: $isolation"
    echo "agent-kind: $AGENT_KIND"
    echo "label: $label"
    echo "agent: $AGENT_CMD"
    echo "date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "symfony-cli: $(symfony version --no-ansi 2>/dev/null | head -1)"
} | tee "$out/environment.txt" > "$evidence/$variant-$(date -u +%Y%m%dT%H%M%SZ).txt"

[ -n "$agent_config" ] && rm -rf "$agent_config"

echo "$out/diff.patch"
