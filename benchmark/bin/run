#!/usr/bin/env bash
# Run one benchmark task in one variant and capture the diff the agent produced.
# Mechanical only: it never decides whether the result is good.
#
#   bin/run 01-lock with-skills
#   bin/run 01-lock without-skills
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo="$(cd "$here/.." && pwd)"

task="${1:?usage: bin/run <task> <with-skills|without-skills>}"
variant="${2:?usage: bin/run <task> <with-skills|without-skills>}"

task_dir="$here/tasks/$task"
[ -d "$task_dir" ] || { echo "error: no task '$task' in $here/tasks" >&2; exit 1; }

case "$variant" in
    with-skills|without-skills) ;;
    *) echo "error: variant must be 'with-skills' or 'without-skills'" >&2; exit 1 ;;
esac

# Override to benchmark a different agent. The prompt arrives on stdin.
AGENT_CMD="${AGENT_CMD:-claude -p --dangerously-skip-permissions --strict-mcp-config}"

# A pristine CLAUDE_CONFIG_DIR keeps the operator's own CLAUDE.md, globally
# installed skills, plugins and MCP servers out of the run — otherwise both
# variants silently inherit them and the baseline is not a baseline.
#
# The login is bound to the config directory, so an isolated run needs its own
# credential. Create one once with `claude setup-token` and export it as
# CLAUDE_CODE_OAUTH_TOKEN, or use ANTHROPIC_API_KEY.
agent_config=""
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    isolation="clean"
    agent_config="$(mktemp -d)"
elif [ "${BENCHMARK_ALLOW_INHERITED:-0}" = "1" ]; then
    isolation="inherited"
else
    cat >&2 <<'MSG'
error: refusing to run without an isolated agent configuration.

Without it the agent inherits ~/.claude/CLAUDE.md, the globally installed
skills and any configured MCP servers — in both variants — so the numbers
say more about this machine than about the skills.

  claude setup-token
  export CLAUDE_CODE_OAUTH_TOKEN=<the token it prints>

Set BENCHMARK_ALLOW_INHERITED=1 to run anyway. The mode is recorded in
environment.txt either way, so a result can never claim to be clean when it
was not.
MSG
    exit 1
fi

# The project is built OUTSIDE this repository on purpose: an agent working
# inside it would have the skills sitting in an ancestor directory and could
# read them in either variant, which is exactly what the two variants are
# supposed to differ by.
workdir="${BENCHMARK_WORKDIR:-${TMPDIR:-/tmp}/symfony-skills-benchmark}"

out="$here/results/$task/$variant"
app="$workdir/$task/$variant/app"

rm -rf "$out" "$app"
mkdir -p "$out" "$(dirname "$app")"

symfony new "$app" --webapp --no-git >"$out/setup.log" 2>&1

cd "$app"
git init -q
git add -A
git -c user.email=benchmark@example.com -c user.name=benchmark commit -qm baseline

if [ "$variant" = "with-skills" ]; then
    mkdir -p .claude/skills
    cp -R "$repo/skills/." .claude/skills/
    # not part of what the agent produced
    echo '.claude/' > .git/info/exclude
fi

# Session plumbing from a surrounding Claude Code session would otherwise make
# this run a child of it.
env -u CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD \
    -u CLAUDE_CODE_BRIDGE_SESSION_ID \
    -u CLAUDE_CODE_CHILD_SESSION \
    -u CLAUDE_CODE_ENTRYPOINT \
    -u CLAUDE_CODE_MESSAGING_SOCKET \
    -u CLAUDE_CODE_MESSAGING_TOKEN \
    -u CLAUDE_CODE_SESSION_ID \
    ${agent_config:+CLAUDE_CONFIG_DIR="$agent_config"} \
    $AGENT_CMD < "$task_dir/TASK.md" > "$out/agent.log" 2>&1 || true

git add -A

# The lock files are ~90% of the raw diff and say nothing a reviewer needs.
# What the agent installed is visible in composer.json, kept separately.
git diff --cached -- . ':(exclude)composer.lock' ':(exclude)symfony.lock' > "$out/diff.patch"
git diff --cached -- composer.json > "$out/packages.patch"

# The Symfony skeleton ships a compose.yaml and agents tend to start it.
if [ -f compose.yaml ] || [ -f docker-compose.yml ]; then
    docker compose down -v >/dev/null 2>&1 || true
fi

{
    echo "isolation: $isolation"
    echo "agent: $AGENT_CMD"
    echo "date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "symfony-cli: $(symfony version --no-ansi 2>/dev/null | head -1)"
} > "$out/environment.txt"

[ -n "$agent_config" ] && rm -rf "$agent_config"

echo "$out/diff.patch"
