/.idea/
/.claude/
/.agents/
/skills-lock.json

# Interview transcripts and research notes stay local
/docs/sources/

# Per-run artifacts stay local (large, and their conclusions belong in RESULTS*.md) —
# but environment.txt (the isolation claim) and verdict-*.json (the scores) are small
# and are the evidence a benchmark PR should carry, so they are not excluded here.
/benchmark/results/*/*/setup.log
/benchmark/results/*/*/agent.log
/benchmark/results/*/*/diff.patch
/benchmark/results/*/*/packages.patch
